        <mxCell id="pA0SYHFykoJP3RdcRZAj-64" edge="1" parent="1" source="pA0SYHFykoJP3RdcRZAj-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" target="pA0SYHFykoJP3RdcRZAj-60">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="19855" y="8670" as="sourcePoint" />
            <mxPoint x="19907" y="8714" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-43" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="128" width="299" x="20438" y="8396" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-44" parent="_PkbPu_AK8JqxYvFUf1v-43" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="Стадия &quot;АПП и отгрузка&quot;&lt;br&gt;&lt;br&gt;У 71П тоже есть ПМы? Я не в курсе просто.&lt;br&gt;&lt;br&gt;71П указывает в качестве ПМа - руководителя отдела - Богомолову Евгению, Ваганова Дмитрия, или Азарова Александра." vertex="1">
          <mxGeometry height="108" width="299" y="20" as="geometry" />
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-39" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Исправить" vertex="1">
          <mxGeometry height="181" width="324" x="21406" y="8358" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-40" parent="_PkbPu_AK8JqxYvFUf1v-39" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="Стадия &quot;АПП и отгрузка&quot;&lt;br&gt;&lt;br&gt;Проверка заполнения ПМа - зачем нужна? Разве возможно попадание сделки в эту точку без заполнения поля с указанием ПМа?&lt;br&gt;&lt;br&gt;Это был костыль, на время переходного периода, когда поле ПМ только-только сделали обязательным. Сейчас можно убирать этот блок." vertex="1">
          <mxGeometry height="161" width="324" y="20" as="geometry" />
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-37" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="Вопросы" vertex="1">
          <mxGeometry height="215" width="626" x="17795" y="8281" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_PkbPu_AK8JqxYvFUf1v-38" parent="_PkbPu_AK8JqxYvFUf1v-37" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="Стадия &quot;АПП и отгрузка&quot;&lt;br&gt;&lt;br&gt;Что за элемент &quot;Редактировать кастомные поля товарной позиции&quot;? И каков статус синхронизации с 1С в части вытягивания данных по отгрузке?&lt;br&gt;&lt;br&gt;Сейчас интеграции нет, это не заполняется из 1С. Вручную - никто не стал делать этого.&lt;br&gt;&lt;br&gt;Сейчас техническая реализация очень кривая - все позиции сразу проставляются, как &quot;отгружен&quot; в полном количестве. Это происходит сразу после того, как Санат выполнит задание &quot;Изготовление изделия&quot; в Битриксе. Короче - бред. Это был костыль.&lt;br&gt;&lt;br&gt;Должно быть либо задание на Нурбола с подтверждением отгрузки, либо через интеграцию, на основании РО брать эти цифры." vertex="1">
          <mxGeometry height="195" width="626" y="20" as="geometry" />
        </mxCell>
        <mxCell id="AQhA-yFcEM964v1He3tP-61" edge="1" parent="1" source="pA0SYHFykoJP3RdcRZAj-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;" target="_PkbPu_AK8JqxYvFUf1v-37">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="17731" y="8652" as="sourcePoint" />
            <mxPoint x="17783" y="8696" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
