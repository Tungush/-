        <mxCell id="hQiVtDy9MT-4NnTIPJLv-40" parent="hQiVtDy9MT-4NnTIPJLv-39" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Кто выполняет:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;{=Variable:Ispolnitelnoe_litso}, {=Variable:Otvetstvennyj}, Гулнур Султанмураткызы [438]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;{=Variable:Otvetstvennyj}:&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Санат Нармагамбетов [384], Имдат Халилов [716], Игорь Быков [458], Ерлан Аккузинов [1625], Виктор Моргунов [902]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;{=Variable:Ispolnitelnoe_litso}:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Один-в-один те же, что и в Otvetstvennyj&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="183" width="270" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-51" parent="hQiVtDy9MT-4NnTIPJLv-39" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Текст задания:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;[u]Создайте &quot;Заказ клиента&quot; в 1С:ERP и вставьте полное наименование Заказа клиента.[/u]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
