        <mxCell id="_AjoF8Q6NC-kzl9doTwK-33" parent="ytnxuMhxfHXnCEjFPLaR-136" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="Вопросы" vertex="1">
          <mxGeometry height="67" width="200" x="16943" y="132" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
