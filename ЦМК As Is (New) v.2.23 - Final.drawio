            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-53" parent="LJf07bQrKGresGSgws5W-52" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Вот это что за элемент, и что конкретно он делает?&lt;br&gt;&lt;i&gt;Он записывает поля в переменные для последующего сравнения и проверки - изменилась ли предоплата.&lt;/i&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="47" width="263" y="20" as="geometry" />
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-54" parent="LJf07bQrKGresGSgws5W-52" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="36.09" width="108.63" x="265" y="19.999999999999854" as="geometry" />
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-51" parent="LJf07bQrKGresGSgws5W-52" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="303.05" width="446.43" y="68" as="geometry" />
        </mxCell>
        <mxCell id="3-MO31gcSxDO7Ki4WwpP-8" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;" value="Гульнур" vertex="1">
          <mxGeometry height="98" width="210" x="7691" y="881" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3-MO31gcSxDO7Ki4WwpP-9" parent="3-MO31gcSxDO7Ki4WwpP-8" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Заводит документы в 1С - всю цепочку - делает только Гульнур. Но Задания выставляются на всех. Им нужен контроль.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="210" y="20" as="geometry" />
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-47" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;" value="Правило" vertex="1">
          <mxGeometry height="71" width="171" x="7450" y="878" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-48" parent="LJf07bQrKGresGSgws5W-47" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;В соответствии с бизнес-регионом и контрагентом (конечником)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="51" width="171" y="20" as="geometry" />
        </mxCell>
        <mxCell id="orYFrwQ3vFqIJepqPr10-49" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" style="endArrow=none;html=1;rounded=0;shape=link;dashed=1;dashPattern=12 12;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="9154" y="1475" />
              <mxPoint x="9154" y="-891" />
              <mxPoint x="7809" y="-891" />
              <mxPoint x="7809" y="809" />
              <mxPoint x="6746" y="809" />
            </Array>
            <mxPoint x="6758" y="1474" as="sourcePoint" />
            <mxPoint x="6746" y="1474" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="orYFrwQ3vFqIJepqPr10-50" parent="ytnxuMhxfHXnCEjFPLaR-63" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#ffff88;strokeColor=#36393d;" value="&lt;font&gt;&lt;span style=&quot;text-align: left; text-wrap-mode: nowrap;&quot;&gt;Стадия &quot;5.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Согласование предоплаты&lt;/span&gt;&lt;span style=&quot;text-align: left; text-wrap-mode: nowrap;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="212" x="6765" y="831" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-194" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="169" width="302" x="4630" y="46" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-195" parent="gK9vAT-kHz9ne5MLc8tK-194" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&quot;&quot;&gt;На стадии &quot;Согласование производства&quot; - по какой логике разделение ответственных происходит, и кто такие Ислам Науразов и Бекжан Жолдасов?&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Они шарят за тендера и тендерную документацию и работают с 71П со стороны ЦМК.&lt;/div&gt;" vertex="1">
          <mxGeometry height="149" width="302" y="20" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-190" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="Изменить на схеме (Изменено)" vertex="1">
          <mxGeometry height="262.12" width="721" x="8135" y="497" as="geometry">
            <mxRectangle height="30" width="140" x="6957" y="14" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-191" parent="gK9vAT-kHz9ne5MLc8tK-190" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="&lt;span style=&quot;text-align: center;&quot;&gt;Раньше Акерке заполняла дохера полей ещё на этой стадии (см. скрин), чего вообще нет на схеме. Теперь это делает Гульнур. Поля де-факто заполняются руками, но на схеме этого нет&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="322" y="20" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-192" parent="gK9vAT-kHz9ne5MLc8tK-190" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="44.2" width="135.29" x="16" y="108.00000000000001" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-193" parent="gK9vAT-kHz9ne5MLc8tK-190" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="237.12" width="351.89" x="337" y="25" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-240" parent="ytnxuMhxfHXnCEjFPLaR-63" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="Расходный ДО - это по сути аналог расходного &quot;денежного&quot; ордера (визирует расходование денежных средств).&lt;br&gt;Юрлица от которого на которое перевести - указываются в ДО.&lt;div&gt;Также, в ДО указывается Заказ на Продажу (А) из Адема.&lt;br&gt;А за каждый ЗнП (А) отвечает конкретный ПМ.&lt;br&gt;А у каждого ПМа есть расчётные счета в нужных юрлицах.&lt;br&gt;Так, по ДО можно определить - с какого именно расчётного счёта нужно перечислять денежные средства по данной ДОшке.&lt;br&gt;&lt;br&gt;С приходными ДО примерно та же логика, с той лишь поправкой, что приходные ДО - это по сути аналог приходных &quot;денежных&quot; ордеров (визирует поступление денежных средств)&lt;/div&gt;" vertex="1">
          <mxGeometry height="199" width="690" x="9218" y="401" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-187" parent="ytnxuMhxfHXnCEjFPLaR-63" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;" value="Создание ДО теперь параллельно идёт, не тормозит весь процесс. Учесть это и отразить на схеме (но сначала проверить в роботах Битрикса и увидеть своими глазами)&lt;br&gt;&lt;br&gt;Создание ДО перенеслись на стадию &quot;Предоплата&quot; уже давно. Отразить это на схеме. При этом - ЗК (от А77 к АС) создаётся на стадии &quot;Предоплата&quot; или в последующих стадиях (глянуть, где точно), а вот ЗП от АС к А77 СРАЗУ создавать НЕ надо - чтобы потом не переделывать ещё и его, если сумма или номенклатура поменяется." vertex="1">
          <mxGeometry height="182" width="349" x="9218" y="788.5" as="geometry" />
        </mxCell>
        <mxCell id="sk9yDuvugpP4l5JV54XF-16" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="Примечание" vertex="1">
          <mxGeometry height="118" width="427" x="7938" y="860" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sk9yDuvugpP4l5JV54XF-17" parent="sk9yDuvugpP4l5JV54XF-16" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Де-факто ЗК (1С:ERP) создаётся по приходу задания &quot;Согласование предоплаты&quot;, и туда же Гульнур вписывает № ЗК в поле &quot;Заказ на продажу&quot;. № счёта она при этом никуда не вписывает, и счёт, как объект в Битриксе - не создаёт.&lt;br&gt;&lt;br&gt;Если это 245 проект - то Гульнур создаёт новую заявку через &quot;Процессы в ленте новостей&quot; ---&amp;gt; &quot;Номер заказа на продажу&quot;, и тогда задание в Битриксе падает на Аяну.&lt;/span&gt;" vertex="1">
          <mxGeometry height="98" width="427" y="20" as="geometry" />
        </mxCell>
        <mxCell id="N0MeQKUY6ttbu4Yo4fhe-15" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="Пожелания" vertex="1">
          <mxGeometry height="76" width="322" x="8463" y="202" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="N0MeQKUY6ttbu4Yo4fhe-16" parent="N0MeQKUY6ttbu4Yo4fhe-15" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;От Акерке есть пожелание ВНЕШНИХ Заказчиков - тоже в какой-нибудь воронке оформлять.&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="322" y="20" as="geometry" />
        </mxCell>
        <mxCell id="xRc2BRPeNyKOX_yF_m6l-2" parent="ytnxuMhxfHXnCEjFPLaR-63" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#ffff88;strokeColor=#36393d;" value="&lt;font&gt;&lt;span style=&quot;text-align: left; text-wrap-mode: nowrap;&quot;&gt;Стадия &quot;7.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Изготовление изделия&lt;/span&gt;&lt;span style=&quot;text-align: left; text-wrap-mode: nowrap;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="212" x="11488" y="81" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-71" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="hQiVtDy9MT-4NnTIPJLv-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hQiVtDy9MT-4NnTIPJLv-66">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
