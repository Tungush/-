          </mxGeometry>
        </mxCell>
        <mxCell id="sZT6_b3Q6xaOgUGejSL0-23" parent="ytnxuMhxfHXnCEjFPLaR-168" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="Вопросы" vertex="1">
          <mxGeometry height="91" width="292" x="9249" y="46" as="geometry">
