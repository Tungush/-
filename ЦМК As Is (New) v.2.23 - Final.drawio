        <mxCell id="_AjoF8Q6NC-kzl9doTwK-27" parent="ytnxuMhxfHXnCEjFPLaR-136" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="Вопросы" vertex="1">
          <mxGeometry height="119" width="233" x="17489" y="301.53" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_AjoF8Q6NC-kzl9doTwK-28" parent="_AjoF8Q6NC-kzl9doTwK-27" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Эммм, не понял - а почему, если приходная ДО создаётся на этапе предоплаты - то мы по подразделениям проверяем, кто её должен создавать (Аяна или Гульнур), а на этом этапе - всегда Фин. телеком (всегда Аяна)?&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="233" y="20" as="geometry" />
        </mxCell>
        <mxCell id="_AjoF8Q6NC-kzl9doTwK-29" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-136" source="_AjoF8Q6NC-kzl9doTwK-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=1 2;curved=1;" target="_AjoF8Q6NC-kzl9doTwK-15">
