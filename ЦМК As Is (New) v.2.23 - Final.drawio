          <mxGeometry height="80" width="120" x="11778" y="210" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-2" parent="hQiVtDy9MT-4NnTIPJLv-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/bmp,;" value="" vertex="1">
