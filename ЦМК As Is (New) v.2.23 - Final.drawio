        <mxCell id="gkicVXzgiS3UYNDCTYG9-13" parent="gkicVXzgiS3UYNDCTYG9-12" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Внутри стадии &quot;&lt;span style=&quot;text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Согласование заявки и проекта&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&quot; дублируется функционал стадии &quot;ПТО. Проверка заказа&quot; - на предмет наличия дублей по ЗП и наименованию сайта. Так и задумано? Это не приведёт к тому, что 2 раза подтверждение процесс будет просить?&lt;br&gt;&lt;br&gt;Дубли вытаскиваются чисто для информации.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="136" width="320" y="20" as="geometry" />
