          </mxGeometry>
        </mxCell>
        <mxCell id="N0MeQKUY6ttbu4Yo4fhe-43" parent="ytnxuMhxfHXnCEjFPLaR-153" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#990000;gradientColor=#ea6b66;" value="Продолжение процесса" vertex="1">
          <mxGeometry height="50" width="50" x="9960" y="402" as="geometry" />
        </mxCell>
        <mxCell id="sZT6_b3Q6xaOgUGejSL0-20" parent="ytnxuMhxfHXnCEjFPLaR-153" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="Примечание" vertex="1">
          <mxGeometry height="157" width="315" x="9386" y="21" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sZT6_b3Q6xaOgUGejSL0-21" parent="sZT6_b3Q6xaOgUGejSL0-20" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;На счета в 1С сажается оплата, НО НЕ ВСЕГДА. На счета, а не на ЗК - потому что бывает несколько счетов на один ЗК. &lt;br&gt;&lt;br&gt;А НЕ ВСЕГДА сажается оплата на счета - потому что когда-то оплата проходит по С/Ф, а не по счёту на оплату. В этих случаях - деньги сажают на ЗК, а не на счёт. Почему не на саму С/Ф - Фирангиз не знает, детали - куда какие деньги и как сажаются - нужно узнавать у отдела фин. контроля - у Елены Богомоловой и Натальи Бескороваевой.&lt;/span&gt;" vertex="1">
          <mxGeometry height="137" width="315" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sZT6_b3Q6xaOgUGejSL0-22" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-153" source="_vjLnoffMdj3NS4CGNyu-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;" target="sZT6_b3Q6xaOgUGejSL0-20">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="9432" y="238" as="sourcePoint" />
            <mxPoint x="9449" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6d959aem4jBEweZMqvpb-88" connectable="0" parent="ytnxuMhxfHXnCEjFPLaR-153" style="group" value="" vertex="1">
          <mxGeometry height="61" width="63" x="10117" y="24" as="geometry" />
        </mxCell>
        <mxCell id="N0MeQKUY6ttbu4Yo4fhe-27" parent="6d959aem4jBEweZMqvpb-88" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=timer;" value="Техническая пауза" vertex="1">
          <mxGeometry height="50" width="50" y="11" as="geometry" />
        </mxCell>
        <mxCell id="6d959aem4jBEweZMqvpb-87" parent="6d959aem4jBEweZMqvpb-88" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/bmp,;" value="" vertex="1">
          <mxGeometry height="33" width="33" x="30" as="geometry" />
        </mxCell>
        <mxCell id="ytnxuMhxfHXnCEjFPLaR-168" parent="ytnxuMhxfHXnCEjFPLaR-1" style="swimlane;startSize=61;horizontal=0;html=1;whiteSpace=wrap;" value="Исполнительное лицо ЦМК&lt;br&gt;(Инженер техпроцесса ЦМК)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;{Кто?}&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="424" width="28618" x="48" y="3466" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-200" parent="ytnxuMhxfHXnCEjFPLaR-168" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="149" width="308" x="9651" y="190" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-201" parent="gK9vAT-kHz9ne5MLc8tK-200" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="Синтаксис циклов в Битриксе? Чтобы меньше дёргать в будущем. И какие циклы бывают в Битриксе?&lt;br&gt;&lt;br&gt;И про счётчики добрую сказку расскажите...&lt;br&gt;&lt;br&gt;Всё по классике, два вида циклов - while и for. Счётчики нужны для Вайла, работают так же, как и в Сях" vertex="1">
          <mxGeometry height="129" width="308" y="20" as="geometry" />
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-204" parent="ytnxuMhxfHXnCEjFPLaR-168" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="189" width="417" x="10005" y="162" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gK9vAT-kHz9ne5MLc8tK-205" parent="gK9vAT-kHz9ne5MLc8tK-204" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="Для каждой сделки запускается новый экземпляр процесса, верно понимаю? &lt;br&gt;&lt;br&gt;Да!&lt;br&gt;&lt;br&gt;&lt;br&gt;Как в Битриксе отличать локальные (внутрипроцессные) переменные от глобальных?&lt;br&gt;&lt;br&gt;Глобальные переменные подписаны, там всегда где-то будет слово &quot;глобальная&quot;" vertex="1">
          <mxGeometry height="169" width="417" y="20" as="geometry" />
        </mxCell>
        <mxCell id="_hGnjV0NAzqjxD0smoro-16" parent="ytnxuMhxfHXnCEjFPLaR-168" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="ВАЖНО!" vertex="1">
          <mxGeometry height="125" width="1009" x="9674" y="9" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_hGnjV0NAzqjxD0smoro-17" parent="_hGnjV0NAzqjxD0smoro-16" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="&lt;font&gt;На данный момент - в случае прохождения по воронке ЦМК сделки со ВНЕШНИМ заказчиком - Фин. телеком, который должен будет создавать ЗК&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;(От А77 --&amp;gt; АС) - вообще не получит задания в автоматизацию об этом, и, соответственно, не будет знать, что нужно создать ЗК в 1Ске... Короче, AS IS имеет дыру, которую нужно срочно латать.&lt;br&gt;Поправка - ВНЕШНИЕ заказчики вообще не должны проходить по воронке ЦМК.&lt;br&gt;&lt;br&gt;На данный момент в Битриксе ВООБЩЕ отсутствует задание на создание ЗК&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;font&gt;(1С:ERP) - Гульнур и Акерке тоже их не получают. Гульнур создаёт ЗК, когда получает задание &quot;Согласование предоплаты&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="1009" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ytnxuMhxfHXnCEjFPLaR-235" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-168" style="endArrow=none;html=1;rounded=0;shape=link;dashed=1;dashPattern=12 12;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="16179" y="-1463" />
              <mxPoint x="16179" y="-2423" />
              <mxPoint x="11479" y="-2423" />
            </Array>
            <mxPoint x="11495" y="-1464.5384615384614" as="sourcePoint" />
