        <mxCell id="LJf07bQrKGresGSgws5W-34" parent="LJf07bQrKGresGSgws5W-32" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/bmp,;" value="" vertex="1">
