        <mxCell id="hQiVtDy9MT-4NnTIPJLv-62" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" value="Вопросы" vertex="1">
