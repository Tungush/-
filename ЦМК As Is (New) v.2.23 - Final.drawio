        <mxCell id="hQiVtDy9MT-4NnTIPJLv-3" parent="ytnxuMhxfHXnCEjFPLaR-63" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=link;fillColor=#e6d0de;strokeColor=#000000;gradientColor=#d5739d;" value="Переход со стадии&lt;br&gt;&quot;5. Согласование &lt;br&gt;предоплаты&quot;" vertex="1">
          <mxGeometry height="50" width="50" x="11535" y="225" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-5" parent="ytnxuMhxfHXnCEjFPLaR-63" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#f8cecc;strokeColor=#b85450;" value="Создать &lt;b&gt;задание&lt;/b&gt; &quot;А.2. Добавить в план производства&quot;" vertex="1">
          <mxGeometry height="80" width="120" x="11706" y="324" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-6" parent="hQiVtDy9MT-4NnTIPJLv-5" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/bmp,;" value="" vertex="1">
          <mxGeometry height="33" width="33" x="102" y="-14" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-7" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="77" width="300" x="11718" y="461.5" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-8" parent="hQiVtDy9MT-4NnTIPJLv-7" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Задание сейчас выключено в Битриксе, а уведомление об этом задании активно. Так и задумано?&lt;br&gt;Задание теперь просто другое, уведомление оставили старое.&lt;br&gt;Промежуточное задание убрано за ненадобностью.&lt;/span&gt;" vertex="1">
          <mxGeometry height="57" width="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-53" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="6d959aem4jBEweZMqvpb-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hQiVtDy9MT-4NnTIPJLv-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-13" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;" value="Поля" vertex="1">
          <mxGeometry height="98" width="334" x="12286" y="79" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-14" parent="hQiVtDy9MT-4NnTIPJLv-13" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Заполнить:&lt;br&gt;1. Ответственный за производство &lt;b&gt;[Справочник]&lt;/b&gt; {Обязательное}&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;2. Планируемая дата окончания производства &lt;b&gt;[Дата]&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{Обязательное}&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="334" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-18" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="6d959aem4jBEweZMqvpb-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;" target="hQiVtDy9MT-4NnTIPJLv-13">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="12535" y="281" as="sourcePoint" />
            <mxPoint x="12587" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hQiVtDy9MT-4NnTIPJLv-20" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="hQiVtDy9MT-4NnTIPJLv-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;" target="hQiVtDy9MT-4NnTIPJLv-5">
