        <mxCell id="3-MO31gcSxDO7Ki4WwpP-15" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Вопросы" vertex="1">
