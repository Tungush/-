        <mxCell id="Rgxp61SflzkMXkrVMtDR-14" parent="_vjLnoffMdj3NS4CGNyu-9" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;absoluteArcSize=1;arcSize=20;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;" value="" vertex="1">
