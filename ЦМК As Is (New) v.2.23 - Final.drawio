        </mxCell>
        <mxCell id="3-MO31gcSxDO7Ki4WwpP-1" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Вопросы" vertex="1">
          <mxGeometry height="125" width="448" x="2476" y="119" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3-MO31gcSxDO7Ki4WwpP-2" parent="3-MO31gcSxDO7Ki4WwpP-1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Ок, переменная, куда сотрудники записываются - множественная. А до присвоения переменной конкретных сотрудников - что там записано? Я верно понимаю, что переменные внутри каждого этапа объявляются заново и изначально &quot;пустые&quot;? Или есть наследование значения переменных из других этапов?&lt;br&gt;&lt;br&gt;Вопрос вызван тем, что на стадии 3 уведомление отправляется до записывания сотрудников в переменную. Вот как узнать/понять - кому оно отправляется?&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="448" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ZXpaKv6w6PtOLcU48wxA-22" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="3-MO31gcSxDO7Ki4WwpP-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 2;curved=1;" target="ZXpaKv6w6PtOLcU48wxA-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2616" y="58" as="sourcePoint" />
            <mxPoint x="2668" y="102" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iz4r9GUXTPfvDfMYAJdy-9" edge="1" parent="ytnxuMhxfHXnCEjFPLaR-63" source="iz4r9GUXTPfvDfMYAJdy-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="iz4r9GUXTPfvDfMYAJdy-5">
