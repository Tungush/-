        <mxCell id="bgZ4iMBpkrZu41ApoR6K-9" parent="bgZ4iMBpkrZu41ApoR6K-8" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;div style=&quot;&quot;&gt;Добавить Асета наблюдателем (вместе с ПМами)&lt;br&gt;&lt;br&gt;Отдельно побеседовать ещё раз с Асетом - куда его добавить, и как ОН сам видит эту воронку&lt;/div&gt;" vertex="1">
          <mxGeometry height="99" width="277" y="20" as="geometry" />
