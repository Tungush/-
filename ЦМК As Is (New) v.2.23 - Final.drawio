        <mxCell id="iz4r9GUXTPfvDfMYAJdy-22" parent="iz4r9GUXTPfvDfMYAJdy-21" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Санат Нармагамбетов [384], Имдат Халилов [716], Рустам Палтушев [383], Бекжан Жолдасов [1758], Игорь Быков [458], Ерлан Аккузинов [1625], Виктор Моргунов [902]&lt;/span&gt;&lt;/div&gt;" vertex="1">
