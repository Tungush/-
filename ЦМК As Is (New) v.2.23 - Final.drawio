        <mxCell id="q4BXbjqWK5eDOC0qSi_4-22" parent="IDakIizApu6xw01tOtnt-12" style="swimlane;whiteSpace=wrap;html=1;startSize=43;dashed=1;" value="А.6. Подтверждение статуса ДО" vertex="1">
          <mxGeometry height="233" width="676" x="2887" y="721" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q4BXbjqWK5eDOC0qSi_4-23" parent="q4BXbjqWK5eDOC0qSi_4-22" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Ознакомить пользователей:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;{=Variable:Fin_otdel_CMK}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;{=Variable:Fin_otdel_CMK}&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Если ЦМК, то это будет Акерке&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Если МАШ, то это Анель Сейдалимова&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="178" width="212" y="47" as="geometry" />
        </mxCell>
        <mxCell id="q4BXbjqWK5eDOC0qSi_4-24" parent="q4BXbjqWK5eDOC0qSi_4-22" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Текст задания:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;В ДО №{{Номер заказа поставщику (Перевыставление)}} статус ДО = {{Статус ДО}}.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;[u]Подтвердите достоверность статуса ДО, тогда заявка отправится на формирование АПП и отгрузку. Либо отправьте заявку на доработку, тогда автоматически создастся заявка на исправление ДО.[/u]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;[b]Заявка в ПТО:[/b] {{Ссылка на элемент (BBcode)}}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="186" width="460" x="215" y="47" as="geometry" />
        </mxCell>
        <mxCell id="q4BXbjqWK5eDOC0qSi_4-26" parent="IDakIizApu6xw01tOtnt-12" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="Исправить в TO BE" vertex="1">
          <mxGeometry height="105" width="294" x="2345" y="645" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q4BXbjqWK5eDOC0qSi_4-27" parent="q4BXbjqWK5eDOC0qSi_4-26" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Сейчас статусы не приходят (проверили по заявкам на завдение ДО). Ранее они приходили из Адем (статус расходной ДО), сейчас это должен быть статус ЗП 1С (от АС &amp;lt;-- А77). Фактически, вся ветка в Битриксе на данный момент неактивна. Но эту логику/ветку можно оживить, если просто получать статусы из 1С.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="294" y="20" as="geometry" />
        </mxCell>
        <mxCell id="0fyZRmFKr05RsNYikF7l-1" connectable="0" parent="IDakIizApu6xw01tOtnt-12" style="group" value="" vertex="1">
