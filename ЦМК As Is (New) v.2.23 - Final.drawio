          <mxGeometry height="71" width="58" x="7228" y="62" as="geometry" />
        </mxCell>
        <mxCell id="LJf07bQrKGresGSgws5W-33" parent="LJf07bQrKGresGSgws5W-32" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#ffff88;strokeColor=#000000;" value="Наша компания = АС?" vertex="1">
          <mxGeometry height="50" width="50" y="21" as="geometry" />
