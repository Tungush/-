        <mxCell id="zPHIfr4lVAXLB9i0IJvP-43" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="Все стадии воронки ЦМК" vertex="1">
          <mxGeometry height="265" width="201" x="56" y="8611" as="geometry">
            <mxRectangle height="30" width="140" x="480" y="20" as="alternateBounds" />
          </mxGeometry>
