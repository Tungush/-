        <mxCell id="ytnxuMhxfHXnCEjFPLaR-232" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;shape=link;dashed=1;dashPattern=12 12;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="2496" y="8446" />
              <mxPoint x="2496" y="8176" />
