        <mxCell id="hQiVtDy9MT-4NnTIPJLv-39" parent="ytnxuMhxfHXnCEjFPLaR-63" style="swimlane;whiteSpace=wrap;html=1;startSize=20;dashed=1;" value="А.3.1. Номер заказа клиента 1С&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;" vertex="1">
